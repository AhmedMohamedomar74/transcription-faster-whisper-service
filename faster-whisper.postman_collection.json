                ]
              }
            }
          ],
          "response": [
            {
              "name": "200 — segments",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"job_id\": \"abc-123\",\n  \"segments\": [\n    {\n      \"start\": 0.0,\n      \"end\": 4.56,\n      \"text\": \"مرحباً بالعالم\",\n      \"words\": []\n    }\n  ]\n}",
              "_postman_previewlanguage": "json"
            }
          ]
        }
      ]
    }
  ]
}
