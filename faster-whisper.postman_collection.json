              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"job_id\": \"abc-123\",\n  \"filename\": \"recording.mp3\",\n  \"model_size\": \"small\",\n  \"language\": \"ar\",\n  \"audio_duration\": 47.32,\n  \"vad_removed_seconds\": 3.12,\n  \"processing_time_seconds\": 12.45,\n  \"chunks\": 6,\n  \"segments\": [{ \"start\": 0.0, \"text\": \"مرحباً\" }],\n  \"created_at\": \"2025-01-01T00:00:00Z\"\n}",
              "_postman_previewlanguage": "json"
            }
          ]
        },
        {
          "name": "Get segments only",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/transcriptions/{{job_id}}/segments",
